# SIF-Guard Environment Configuration

# Database settings (PostgreSQL with pgvector or fallback SQLite)
DATABASE_URL=postgresql://sif_user:sif_password@localhost:5432/sif_guard_db
# For SQLite local testing:
# DATABASE_URL=sqlite:///./sif_guard.db

# ML & NLP settings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SIF_MODEL_PATH=sif-guard/app/ml/models/sif_xgboost_v1.json
MODEL_DIR=sif-guard/app/ml/models
LSR_THRESHOLD=0.65
SIMILARITY_THRESHOLD=0.70
BATCH_SIZE=32

# MLflow tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Application environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production
